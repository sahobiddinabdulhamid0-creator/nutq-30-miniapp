PORT=3000
NODE_ENV=development

# Gemini API — server tomonda qoladi, frontendga chiqarilmaydi.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_ANALYSIS_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_PRIMARY_TIMEOUT_MS=10000
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_LIVE_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Telegram bot va Mini App.
BOT_TOKEN=
MINI_APP_URL=
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=

# Faqat shu Telegram IDlar kira oladi. Masalan: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# Lokal brauzerda ikki test profilidan foydalanish uchun.
ALLOW_DEV_AUTH=true

# Render persistent disk ishlatilsa: /var/data/nutq30
DATA_DIR=

# Productionda progressni Cloudflare R2 private bucketida saqlash uchun.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nutq-30-data
R2_OBJECT_KEY=production/users.json
