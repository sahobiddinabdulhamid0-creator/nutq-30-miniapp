PORT=3000
NODE_ENV=development

# Gemini API — server tomonda qoladi, frontendga chiqarilmaydi.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_ANALYSIS_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Telegram bot va Mini App.
BOT_TOKEN=
MINI_APP_URL=
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=

# Faqat shu Telegram IDlar kira oladi. Masalan: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# Lokal brauzerda ikki test profilidan foydalanish uchun.
ALLOW_DEV_AUTH=true

# Render persistent disk ishlatilsa: /var/data/nutq30
DATA_DIR=
